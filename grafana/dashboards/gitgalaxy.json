        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "gitgalaxy-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(bucket, 'MM-DD HH24\"시\"') AS \"시간대\",\n       sum(star_count) AS \"스타\", sum(commit_count) AS \"커밋\", sum(pr_created) AS \"PR\",\n       sum(issue_opened) AS \"이슈\", sum(fork_count) AS \"포크\", sum(release_count) AS \"릴리즈\"\nFROM repo_time GROUP BY bucket ORDER BY bucket"
        }

          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT full_name AS \"레포\", language AS \"언어\", star_count AS \"스타\", fork_count AS \"포크\",\n       open_issues_count AS \"열린 이슈\", last_collected_at AS \"수집 시각\"\nFROM repos WHERE tracked ORDER BY star_count DESC LIMIT 20"

    {
      "type": "timeseries",
      "title": "레포 등록 추이 (5분 단위)",
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gitgalaxy-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "gitgalaxy-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- 앱이 KST 기준 timestamp(타임존 없음)로 저장 → UTC로 해석되지 않게 변환\nSELECT $__timeGroupAlias(ts, '5m'), count(*) AS \"등록/갱신 레포\"\nFROM (SELECT last_collected_at AT TIME ZONE 'Asia/Seoul' AS ts FROM repos WHERE tracked) t\nWHERE $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "임베딩 저장 추이 (5분 단위, 종류별)",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gitgalaxy-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "gitgalaxy-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- 앱이 KST 기준 timestamp(타임존 없음)로 저장 → UTC로 해석되지 않게 변환\nSELECT $__timeGroupAlias(ts, '5m'), metric, count(*) AS value\nFROM (SELECT embedded_at AT TIME ZONE 'Asia/Seoul' AS ts,\n             CASE WHEN file_path = 'README.md' THEN 'README' ELSE replace(file_path, 'events/', '') END AS metric\n      FROM chunk_embeddings) t\nWHERE $__timeFilter(ts)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "청크 종류별 개수",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "gitgalaxy-db"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "gitgalaxy-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN file_path = 'README.md' THEN 'README' ELSE replace(file_path, 'events/', '') END AS \"종류\",\n       count(*) AS \"개수\"\nFROM chunk_embeddings GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "legend": {
          "displayMode": "table",
